# PostHog analytics — get your key from Project Settings in PostHog
VITE_POSTHOG_KEY=phc_your_project_api_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Vercel Blob — used by api/send-mail.ts to store envelope contact form submissions.
# Auto-populated by `vercel env pull` once a Blob store is linked to the project;
# no manual signup needed (unlike the old Resend integration this replaced).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
